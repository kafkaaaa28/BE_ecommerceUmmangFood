// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}
enum LoginEventProvider {
  GOOGLE
  EMAIL
}
enum AuditAction {
  USER_CREATE
  USER_UPDATE
  USER_SUSPEND
  PRODUCT_CREATE
  PRODUCT_UPDATE
  ORDER_UPDATE
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVE
  RELEASE
  DEDUCT
}
enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}
enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
}
enum PaymentGateway {
  DUITKU
}
enum PaymentMethod {
  BANK_TRANSFER
  COD
  E_WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  RETURNED
}
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  REFUNDED
  CANCELLED
}
enum RefundReason {
  WRONG_ITEM
  DAMAGED
  NOT_RECEIVED
  CUSTOMER_CHANGED_MIND
  OTHER
}
enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}
model LoginEvent {
  id        String   @id @db.VarChar(255)
  userId    String?  @db.VarChar(255)
  email     String?  @db.VarChar(255)
  provider  LoginEventProvider
  success   Boolean  @default(true)
  reason    String   @db.VarChar(255)
  ipAddress String   @db.VarChar(255)
  createdAt DateTime @default(now())

}
model AuditLog {
  id        String      @id @default(cuid()) // "clx_audit_001"

  actorId   String?     // "clx_user_admin_001"
  action    AuditAction // USER_UPDATE

  entity    String      // "User"
  entityId  String?     // "clx_user_001"

  metadata  Json?       // {"before":"ACTIVE","after":"SUSPENDED"}
  ipAddress String?     // "103.10.10.1"
  userAgent String?     // "Mozilla/5.0"

  createdAt DateTime    @default(now()) // "2026-02-21T10:00:00Z"


  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

model Account {
  userId            String // "clx_user_001"
  type              String // "oauth"
  provider          String // "google"
  providerAccountId String // "1182xxxx"

  refresh_token String? // "rt_abc123"
  access_token  String? // "at_abc123"
  expires_at    Int?    // 1735689600
  token_type    String? // "Bearer"
  scope         String? // "openid email profile"
  id_token      String? // "eyJhbGciOi..."
  session_state String? // "sess_01"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}


model User {
  id            String    @id @default(cuid()) // "clx_user_001"
  name          String?   // "kafka", "farel"
  email         String     // "kafka@mail.com"
  normalizedEmail String   @unique
  emailVerified DateTime  @default(now())// "2026-02-21T10:00:00Z"
  image         String?   // "https://cdn.site/avatar-kafka.png"

  phone           String?   @unique // "081234567890"
  phoneVerifiedAt DateTime? // "2026-02-21T10:05:00Z"

  role          UserRole   @default(BUYER) // BUYER
  status        UserStatus @default(ACTIVE) // ACTIVE

  createdAt     DateTime   @default(now()) // "2026-02-21T09:00:00Z"
  updatedAt     DateTime   @updatedAt // "2026-02-21T11:00:00Z"
  deletedAt     DateTime?  // null

  // relations
  accounts       Account[]
  addresses      Address[]
  orders         Order[]         @relation("BuyerOrders")
  stockMovements StockMovement[] @relation("StockActor")
  productReviews ProductReview[]
  reviewReplies ReviewReply[]
  @@index([role])
  @@index([status])
}

model Address {
  id            String   @id @default(cuid()) // "clx_addr_001"
  userId        String   // "clx_user_001"

  label         String   // "Rumah"
  recipientName String   // "Kafka"
  phone         String   @unique // "081234567890"

  jalan         String   // "Jl. Merdeka No.1"
  provinsi      String   // "Jawa Barat"
  kota          String   // "Bandung"
  kecamatan      String  // "Coblong"
  kelurahan    String    // "Dago"
  kodePos   String   @default("ID") // "40135"

  destinationId   Int?    // 23
  destinationLabel String? // "Bandung Kota"

  isDefault     Boolean  @default(false) // true

  createdAt     DateTime @default(now()) // "2026-02-21T09:10:00Z"
  updatedAt     DateTime @updatedAt // "2026-02-21T11:00:00Z"
  deletedAt     DateTime? // null

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([destinationId])
}

model StoreSetting {
  id         String             @id @default(cuid()) // "clx_store_001"
  storeName  String             // "Terasi Mart"

  originId   Int // 501
  originLabel String // "Gudang Utama Bandung"

  createdAt  DateTime @default(now()) // "2026-02-21T09:00:00Z"
  updatedAt  DateTime @updatedAt // "2026-02-21T11:00:00Z"
}
// stok

model StockMovement {
  id          String            @id @default(cuid()) // "clx_move_001"
  inventoryId String // "clx_inv_001"
  type        StockMovementType // STOCK_IN
  qty         Int // 20
  note        String? // "restock supplier"
  refType     String? // "PURCHASE"
  refId       String? // "PO-0001"

  actorId     String? // "clx_user_admin_001"
  createdAt   DateTime          @default(now()) // "2026-02-21T10:00:00Z"

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor     User?     @relation("StockActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([type, createdAt])
  @@index([refType, refId])
  @@index([actorId])
}

model Inventory {
  id           String   @id @default(cuid()) // "clx_inv_001"
  variantId    String   @unique // "clx_var_001"

  onHand       Int      @default(0) // 120
  reserved     Int      @default(0) // 5
  reorderLevel Int      @default(0) // 20

  updatedAt    DateTime @updatedAt // "2026-02-21T11:00:00Z"

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements   StockMovement[]

  @@index([reorderLevel])
}

model ProductVariant {
  id          String   @id @default(cuid()) // "clx_var_001"
  productId   String   // "clx_prod_001"

  sku         String   @unique // "TRS-ABC-100"
  variantName String   // "100gr", "250gr", dll
  price       Decimal  @db.Decimal(12, 2) // 25000.00
  weightGram  Int? // 100
  isActive    Boolean  @default(true) // true
  imageUrl    String? // "https://cdn.site/products/abc-100.png"

  createdAt   DateTime @default(now()) // "2026-02-21T09:00:00Z"
  updatedAt   DateTime @updatedAt // "2026-02-21T11:00:00Z"

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?
  orderItems  OrderItem[]

  @@index([productId])
  @@index([isActive])
  productMedias ProductMedia[]
}

model Product {
  id          String        @id @default(cuid()) // "clx_prod_001"
  name        String // "Terasi Premium"
  slug        String        @unique // "terasi-premium"
  description String?       @db.Text // "Terasi udang pilihan..."
  status      ProductStatus @default(DRAFT) // ACTIVE

  categoryId  String? // "clx_cat_001"
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now()) // "2026-02-21T09:00:00Z"
  updatedAt   DateTime      @updatedAt // "2026-02-21T11:00:00Z"

  variants    ProductVariant[]
  productMedias ProductMedia[]
  productReviews ProductReview[]

  @@index([status])
  @@index([categoryId])
}
model ProductMedia {
  id        String    @id @default(cuid()) // "clx_media_001"
  productId String    // "clx_prod_001"
  variantId String?   // "clx_var_001" atau null

  type      MediaType 
  url       String    // "https://cdn.example.com/products/prod_001_img1.jpg"
  alt       String?   // "Sambal Terasi Tampilan Depan"
  sortOrder Int       @default(0) // 0
  isPrimary Boolean   @default(false) // true

  createdAt DateTime  @default(now()) // "2026-02-21T10:00:00Z"

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@index([productId, isPrimary])
}
model Category {
  id        String   @id @default(cuid()) // "clx_cat_001"
  name      String   // "Bumbu Dapur"
  slug      String   @unique // "bumbu-dapur"

  createdAt DateTime @default(now()) // "2026-02-21T09:00:00Z"
  updatedAt DateTime @updatedAt // "2026-02-21T11:00:00Z"

  products  Product[]
}

model OrderItem {
  id        String  @id @default(cuid()) // "clx_item_001"
  orderId   String // "clx_order_001"
  variantId String // "clx_var_001"

  qty       Int // 2
  unitPrice Decimal @db.Decimal(12, 2) // 25000.00
  lineTotal Decimal @db.Decimal(12, 2) // 50000.00

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

model Order {
  id        String      @id @default(cuid()) // "clx_order_001"
  code      String      @unique // "ORD-20260221-0001"

  buyerId   String // "clx_user_001"
  status    OrderStatus @default(PENDING_PAYMENT) // PAID

  namaPenerima       String // "Kafka"
  phone      String  @db.VarChar(30) // "081234567890"
  jalan      String // "Jl. Merdeka No.1"
  kota       String? // "Bandung"
provinsi   String? // "Jawa Barat"
  kodePos String? // "40135"

  shipDestinationId   Int? // 23
  shipDestinationLabel  String? // "Bandung Kota"
  shipCourierCode     String?   // "jne"
  shipServiceCode     String?   // "REG"
  shipEtd             String?   // "2-3 hari"
  shipWeightGram      Int? // 250

  subtotal    Decimal   @db.Decimal(12, 2) // 50000.00
  shippingFee Decimal   @db.Decimal(12, 2) @default(0) // 10000.00
  total       Decimal   @db.Decimal(12, 2) // 60000.00

  notes       String?   @db.Text // "Tolong kirim sore"
  expiresAt   DateTime? // "2026-02-21T12:00:00Z"
  paidAt      DateTime? // "2026-02-21T11:30:00Z"

  createdAt   DateTime  @default(now()) // "2026-02-21T10:00:00Z"
  updatedAt   DateTime  @updatedAt // "2026-02-21T11:30:00Z"

  buyer       User      @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payment     Payment?
  shipment    Shipment?
  refundRequest RefundRequest?
  productReviews ProductReview[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([shipDestinationId])
  @@index([shipCourierCode])
}

model Payment {
  id        String        @id @default(cuid()) // "clx_pay_001"
  orderId   String        @unique // "clx_order_001"

  method    PaymentMethod // BANK_TRANSFER
  status    PaymentStatus @default(PENDING) // PAID
  amount    Decimal       @db.Decimal(12, 2) // 60000.00

  gateway              PaymentGateway @default(DUITKU) // DUITKU
  channelCode          String?       // "BCA_VA"
  gatewayReference     String?        @unique // "INV-8821"
  paymentUrl           String? // "https://pay.duitku.com/..."
  gatewayStatusCode    String? // "00"
  gatewayStatusMessage String? // "SUCCESS"

  publisherOrderId     String? // "PUB-0001"
  callbackPayload      Json? // {"status":"PAID"}
  callbackAt           DateTime? // "2026-02-21T11:31:00Z"

  proofUrl  String? // "https://cdn.site/payments/proof-001.jpg"
  paidAt    DateTime? // "2026-02-21T11:30:00Z"

  createdAt DateTime @default(now()) // "2026-02-21T11:00:00Z"
  updatedAt DateTime @updatedAt // "2026-02-21T11:31:00Z"

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([method])
  @@index([channelCode])
}

model Shipment {
  id         String         @id @default(cuid()) // "clx_ship_001"
  orderId    String         @unique // "clx_order_001"
  status     ShipmentStatus @default(PENDING) // SHIPPED
  courier     String? // "JNE"
  courierCode String? // "jne"
  serviceCode String? // "REG"
  trackingNo  String? // "JNE123456789"
  etd         String? // "2-3 hari"

  shippedAt   DateTime? // "2026-02-21T13:00:00Z"
  deliveredAt DateTime? // "2026-02-23T15:30:00Z"

  createdAt   DateTime @default(now()) // "2026-02-21T12:30:00Z"
  updatedAt   DateTime @updatedAt // "2026-02-21T13:00:00Z"

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([trackingNo])
}

model RefundRequest {
  id           String       @id @default(cuid()) // "clx_ref_001"
  orderId      String       @unique // "clx_order_001"

  reason       RefundReason // WRONG_ITEM
  reasonDetail String?      @db.Text // "Kemasan sobek saat diterima"
  status       RefundStatus @default(REQUESTED) // REQUESTED

  amount       Decimal?     @db.Decimal(12, 2) // 60000.00
  note         String?      @db.Text // "Menunggu verifikasi admin"

  requestedAt  DateTime     @default(now()) // "2026-02-24T09:00:00Z"
  reviewedAt   DateTime?    // "2026-02-24T10:00:00Z"
  completedAt  DateTime?    // "2026-02-25T13:00:00Z"

  createdAt    DateTime     @default(now()) // "2026-02-24T09:00:00Z"
  updatedAt    DateTime     @updatedAt // "2026-02-24T10:00:00Z"

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
model ProductReview {
  id        String       @id @default(cuid()) // "clx_rev_001"

  productId String       // "clx_prod_001"
  buyerId   String       // "clx_user_001"
  orderId   String       // "clx_order_001"

  rating    Int          // 5
  comment   String?      @db.Text // "Produknya sangat enak dan pengiriman cepat!"

  status    ReviewStatus @default(PENDING) // PENDING
moderationReason String? // (mis. PROFANITY, NUDITY, SPAM, PII) 
moderatedAt DateTime?
moderatedBy String? // (admin/system)
  createdAt DateTime     @default(now()) // "2026-02-22T09:00:00Z"
  updatedAt DateTime     @updatedAt // "2026-02-22T09:05:00Z"
  deletedAt DateTime?    // null

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer     User         @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  replies   ReviewReply[]
  media     ReviewMedia[]

  @@unique([buyerId, orderId, productId])

  @@index([productId, status, createdAt])
  @@index([buyerId, createdAt])
  @@index([deletedAt])
}
model ReviewReply {
  id        String   @id @default(cuid()) // "clx_reply_001"
  reviewId  String   // "clx_rev_001"
  actorId   String   // "clx_user_seller_001"

  message   String   @db.Text // "Terima kasih atas reviewnya 🙏"

  createdAt DateTime @default(now()) // "2026-02-22T10:00:00Z"

  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor     User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reviewId, createdAt])
  @@index([actorId, createdAt])
}
model ReviewMedia {
  id        String   @id @default(cuid()) // "clx_media_001"
  reviewId  String   // "clx_rev_001"
  type      MediaType 
  url       String   // "https://cdn.example.com/reviews/rev_001_img1.jpg"

  createdAt DateTime @default(now()) // "2026-02-22T09:10:00Z"

  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}
